# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
SELF_URL=https://example.mctai.app
ALLOWED_CORS_ORIGIN=https://example.mctai.app

# PostgreSQL
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/sinly_18b0_app?sslmode=disable
DATABASE_MAX_CONNECTIONS=5
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL_VERIFY=false

# Ideavibes Auth
MCTAI_AUTH_URL=https://auth.mctai.app
MCTAI_AUTH_APP_TOKEN=app_example_token
MCTAI_AUTH_JWKS_URL=https://auth.mctai.app/.well-known/jwks.json

# API Key encryption
API_KEY_ENCRYPTION_SALT=replace-with-random-32-byte-salt
API_KEY_ENCRYPTION_SECRET=replace-with-random-32-byte-secret

# Ideavibes Email
MCTAI_EMAIL_URL=https://email.mctai.app/send
MCTAI_EMAIL_APP_TOKEN=email_app_example_token

# Payment
PAYMENT_PROVIDER=alipay
PAYMENT_APP_ID=replace-with-payment-app-id
PAYMENT_MERCHANT_ID=replace-with-payment-merchant-id
PAYMENT_GATEWAY_URL=https://payment-gateway.example.com/orders
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
PAYMENT_RETURN_URL=https://example.mctai.app/membership
PAYMENT_NOTIFY_URL=https://example.mctai.app/api/payments/callback/alipay
MEMBERSHIP_ANNUAL_PRICE_CENTS=19900
PAYMENT_CURRENCY=CNY

# Official map providers
AMAP_API_KEY=replace-with-amap-key
TENCENT_MAP_API_KEY=replace-with-tencent-map-key
